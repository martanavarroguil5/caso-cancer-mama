{
  "name": "cnn_local_cinetica_uniforme",
  "model": {
    "architecture": "native256_kinetic_smooth_local_cnn_v1",
    "input_phases": [
      "PRE",
      "EARLY",
      "LATE"
    ],
    "temporal_channels": [
      "PRE",
      "EARLY",
      "LATE",
      "EARLY-PRE",
      "LATE-PRE",
      "EARLY-LATE"
    ],
    "input_size": 256,
    "backbone_channels": [
      16,
      32,
      64,
      96
    ],
    "conv_per_block": 2,
    "conv_stride": 1,
    "normalization": "batch",
    "downsampling": "max2_stride1_then_fixed_binomial3_stride2_zero_padding1",
    "feature_grid": 16,
    "hidden": 32,
    "dropout": 0.35,
    "spatial_dropout": 0.1,
    "pooling": "uniforme",
    "attention_mixture": 0.5,
    "attention_temperature": 2.0,
    "gate_initialization": "zero_uniform",
    "clinical": null,
    "slice_output": "one_logit",
    "patient_aggregation": "mean_probabilities"
  },
  "training": {
    "epochs": 40,
    "min_epochs": 14,
    "patience": 8,
    "min_delta": 0.001,
    "batch_size": 32,
    "lr": 0.0003,
    "min_lr": 1e-05,
    "weight_decay": 0.01,
    "clip_grad_norm": 5.0,
    "amp": true,
    "num_workers": 0,
    "cpu_threads": 4,
    "deterministic": true
  },
  "augmentation": {
    "hflip": 0.5,
    "rot90": true
  },
  "evaluation": {
    "unit": "patient",
    "slice_aggregation": "mean",
    "outer_protocol": "five_fold_patient_cv_with_inner_selection",
    "inner_selection_fraction": 0.15,
    "inner_split_seed": 20261014,
    "checkpoint_metric": "min_inner_patient_bce_same_pos_weight_as_training",
    "primary_threshold_strategy": "max_sensitivity_at_min_specificity",
    "min_specificity": 0.95,
    "secondary_threshold_strategy": "max_macro_f1",
    "test_policy": "never_load_during_development"
  },
  "hypothesis": "Preservar resolución nativa con reducciones suaves y una cuadrícula16x16; comparar media espacial frente a atención acotada dentro del corte",
  "history_plot_title": "CNN local uniforme: fit y selección por paciente",
  "loss": "normal",
  "seed": 42,
  "pos_weight": 1.0,
